# ==========================================
# 1. DEPENDENCIES (Node Modules)
# ==========================================
# We ignore node_modules because they are huge, and anyone cloning the repo 
# can simply run 'npm install' to recreate them based on package.json.
node_modules/
server/node_modules/
client/node_modules/

# ==========================================
# 2. ENVIRONMENT VARIABLES (Secrets & Keys)
# ==========================================
# We ignore .env files to prevent accidentally uploading sensitive information 
# like database passwords or API keys to the public internet.
.env
server/.env
client/.env

# ==========================================
# 3. BUILD OUTPUTS
# ==========================================
# We ignore build folders because they are automatically generated from our 
# source code whenever we build the app for production.
dist/
server/dist/
client/dist/
build/

# ==========================================
# 4. OS & EDITOR FILES
# ==========================================
# These files are automatically generated by the operating system (like Mac's Finder) 
# or code editors (like VS Code), and shouldn't clutter the codebase.
.DS_Store
.vscode/
Thumbs.db
node_modules
